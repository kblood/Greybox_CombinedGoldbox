              "semanticDifferences": { "const": 233 },
              "nullEntryIndexPromotions": { "const": 0 },
              "frameIndexHashPromotions": { "const": 0 },
              "blockIndexHashPromotions": { "const": 182 },
              "blockIndexCandidateRowsDisclosed": { "const": 51 }
