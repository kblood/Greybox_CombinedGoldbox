{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dionysus.dk/schemas/cok-graphics-alias-registry-review-v1.schema.json",
  "title": "CoK Restyle alias registry compatibility review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "inputs", "counts", "semanticProjectionSha256",
    "updatedSidecarSha256", "differences", "nullEntryIndexPromotions", "limitations"
  ],
  "properties": {
    "schema": { "const": "cok-graphics-alias-registry-review-v1" },
    "status": { "enum": ["exactly-compatible", "reviewed-null-entry-index-correction", "reviewed-entry-index-hash-correction", "reviewed-frame-index-hash-correction", "reviewed-block-index-hash-correction", "reviewed-amiga-comspr-hash-correction", "reviewed-exact-curated-face-links"] },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priorSidecarSha256", "priorRegistrySha256", "currentRegistrySha256", "inventorySha256", "curatedManifestSha256", "runtimeComparisonSha256"],
      "properties": {
        "priorSidecarSha256": { "$ref": "#/$defs/hash" },
        "priorRegistrySha256": { "$ref": "#/$defs/hash" },
        "currentRegistrySha256": { "$ref": "#/$defs/hash" },
        "inventorySha256": { "$ref": "#/$defs/hash" },
        "curatedManifestSha256": { "$ref": "#/$defs/hash" },
        "runtimeComparisonSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAliasesBefore", "generatedAliasesAfter", "externalAliasesBefore", "externalAliasesAfter", "boundAliasesAfter", "boundAliasesWithLocatorArchiveSourceOutputAndCardEvidence", "unresolvedAliasesRetained", "aliasCandidateSetsUnchanged", "curatedCardsBefore", "curatedCardsAfter", "curatedSourceLinksAfter", "curatedMultiSourceCardsAfter", "curatedUnresolvedCardsRetained", "inventoryPngFilesExpected", "inventoryPngFilesVerified", "inventoryPngFilesMissing", "inventoryPngFilesHashMismatch", "semanticDifferences", "nullEntryIndexPromotions"],
      "properties": {
        "generatedAliasesBefore": { "const": 6151 },
        "generatedAliasesAfter": { "const": 6151 },
        "externalAliasesBefore": { "const": 1 },
        "externalAliasesAfter": { "const": 1 },
        "boundAliasesAfter": { "type": "integer", "minimum": 0 },
        "boundAliasesWithLocatorArchiveSourceOutputAndCardEvidence": { "type": "integer", "minimum": 0 },
        "unresolvedAliasesRetained": { "type": "integer", "minimum": 0 },
        "aliasCandidateSetsUnchanged": { "type": "integer", "minimum": 0 },
        "curatedCardsBefore": { "const": 27 },
        "curatedCardsAfter": { "const": 27 },
        "curatedSourceLinksAfter": { "type": "integer", "minimum": 0 },
        "curatedMultiSourceCardsAfter": { "type": "integer", "minimum": 0 },
        "curatedUnresolvedCardsRetained": { "type": "integer", "minimum": 0 },
        "inventoryPngFilesExpected": { "const": 4840 },
        "inventoryPngFilesVerified": { "type": "integer", "minimum": 0 },
        "inventoryPngFilesMissing": { "type": "integer", "minimum": 0 },
        "inventoryPngFilesHashMismatch": { "type": "integer", "minimum": 0 },
        "semanticDifferences": { "type": "integer", "minimum": 0 },
        "nullEntryIndexPromotions": { "type": "integer", "minimum": 0 },
        "entryIndexHashPromotions": { "type": "integer", "minimum": 0 },
        "frameIndexHashPromotions": { "type": "integer", "minimum": 0 },
        "blockIndexHashPromotions": { "type": "integer", "minimum": 0 },
        "blockIndexCandidateRowsDisclosed": { "type": "integer", "minimum": 0 },
        "amigaComsprHashPromotions": { "type": "integer", "minimum": 0 },
        "amigaComsprCandidateRowsDisclosed": { "type": "integer", "minimum": 0 }
      }
    },
    "semanticProjectionSha256": { "$ref": "#/$defs/hash" },
    "updatedSidecarSha256": { "$ref": "#/$defs/hash" },
    "differences": { "type": "array" },
    "nullEntryIndexPromotions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "entryIndexHashPromotions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "frameIndexHashPromotions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blockIndexHashPromotions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blockIndexCandidateRowsDisclosed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reviewedCuratedFaceLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cardId", "sourceSha256", "outputSha256", "sourceAssetIds"],
        "properties": {
          "cardId": { "enum": ["face_cok_amiga_068", "face_cok_amiga_069", "face_cok_dos_068", "face_cok_dos_069"] },
          "sourceSha256": { "$ref": "#/$defs/hash" },
          "outputSha256": { "$ref": "#/$defs/hash" },
          "sourceAssetIds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "amigaComsprHashPromotions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "amigaComsprCandidateRowsDisclosed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "amigaComsprArchivePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "actualSha256", "scope"],
      "properties": {
        "name": { "const": "comspr.daa" },
        "sha256": { "$ref": "#/$defs/hash" },
        "actualSha256": { "$ref": "#/$defs/hash" },
        "scope": { "const": "hash-pinned local candidate/fixture copy only; independent retail/WHDLoad provenance is not established" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "exactly-compatible" } }, "required": ["status"] },
      "then": {
        "properties": {
          "counts": { "type": "object", "properties": { "semanticDifferences": { "const": 0 }, "nullEntryIndexPromotions": { "const": 0 }, "frameIndexHashPromotions": { "const": 0 }, "blockIndexHashPromotions": { "const": 0 } } },
