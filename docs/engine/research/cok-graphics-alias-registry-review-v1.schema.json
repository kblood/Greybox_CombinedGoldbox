          "frameIndexHashPromotions": { "type": "array", "maxItems": 0 },
          "blockIndexHashPromotions": { "type": "array", "minItems": 182, "maxItems": 182 },
          "blockIndexCandidateRowsDisclosed": { "type": "array", "minItems": 51, "maxItems": 51 }
