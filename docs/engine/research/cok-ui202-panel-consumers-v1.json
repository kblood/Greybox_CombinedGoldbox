  "panels": [
    {
      "id": "character-sheet",
      "routes": [
        {
          "id": "main-menu-view",
          "producer": "mainMenu View action forwards CoK `frameTiles`",
          "consumer": "openCharSheet \u2192 charSheet.paint \u2192 composeCharSheet \u2192 drawOuterBorder"
        },
        {
          "id": "exploration-view",
          "producer": "explore View action forwards CoK `frameTiles`",
          "consumer": "openCharSheet \u2192 charSheet.paint \u2192 composeCharSheet \u2192 drawOuterBorder"
        },
        {
          "id": "combat-view",
          "producer": "combat View action enters the shared character-sheet route with CoK `frameTiles`",
          "consumer": "openCharSheet \u2192 charSheet.paint \u2192 composeCharSheet \u2192 drawOuterBorder"
        },
        {
          "id": "companion-character-tab",
          "producer": "companionPanel.paint forwards `source.frameTiles` and `source.frameLayout`",
          "consumer": "composeCharSheet \u2192 drawOuterBorder"
        }
      ]
    },
    {
      "id": "automap",
      "routes": [
        {
          "id": "standalone-inspector",
          "producer": "startAutomap \u2192 gameData('cok').tilesPath \u2192 block-202 loadChrome",
          "consumer": "drawScreen \u2192 composeAutomapPanel \u2192 drawOuterBorder",
          "condition": "Development-only standalone inspector."
        },
        {
          "id": "companion-automap-tab",
          "producer": "companionPanel.paint forwards `source.frameTiles` and `source.frameLayout`",
          "consumer": "composeAutomapPanel \u2192 drawOuterBorder"
        }
      ]
    },
    {
      "id": "party-hud",
      "routes": [
        {
          "id": "standalone-hud",
          "producer": "startHud \u2192 CoK TILES_PATH \u2192 block-202 loadChrome",
          "consumer": "drawScreen \u2192 composeHudPanel \u2192 drawOuterBorder"
        },
        {
          "id": "companion-hud-tab",
          "producer": "companionPanel.paint forwards `source.frameTiles` and `source.frameLayout`",
          "consumer": "composeHudPanel \u2192 drawOuterBorder"
        }
      ]
    },
    {
      "id": "inventory",
      "routes": [
        {
          "id": "standalone-inventory",
          "producer": "startInventory \u2192 CoK TILES_PATH \u2192 block-202 decode",
          "consumer": "paint \u2192 composeInventory \u2192 drawOuterBorder"
        },
        {
          "id": "character-sheet-items",
          "producer": "charSheet forwards its CoK tiles to openInventory",
          "consumer": "paint \u2192 composeInventory \u2192 drawOuterBorder"
        }
      ]
    },
    {
      "id": "journal",
      "routes": [
        {
          "id": "standalone-journal",
          "producer": "startJournal \u2192 CoK TILES_PATH \u2192 block-202 loadChrome",
          "consumer": "drawScreen \u2192 composeJournalScreen \u2192 drawOuterBorder"
        },
        {
          "id": "companion-journal-tab",
          "producer": "companionPanel.paint forwards `source.frameTiles` and `source.frameLayout`",
          "consumer": "composeJournalScreen \u2192 drawOuterBorder"
        }
      ]
    },
    {
      "id": "main-menu",
      "routes": [
        {
          "id": "standalone-main-menu",
          "producer": "startMainMenu \u2192 CoK TILES_PATH \u2192 block-202 loadChrome",
          "consumer": "draw \u2192 composeMainMenu \u2192 drawOuterBorder"
        }
      ]
    },
    {
      "id": "reference-database",
      "routes": [
        {
          "id": "standalone-reference-database",
          "producer": "startReferenceDb \u2192 CoK TILES_PATH \u2192 block-202 loadChrome",
          "consumer": "drawScreen \u2192 composeReferenceDb \u2192 drawOuterBorder"
        },
        {
          "id": "companion-reference-tab",
          "producer": "companionPanel.paint forwards `source.frameTiles` and `source.frameLayout`",
          "consumer": "composeReferenceDb \u2192 drawOuterBorder"
        }
      ]
    },
    {
      "id": "spellbook",
      "routes": [
        {
          "id": "exploration-spellbook",
          "producer": "CoK exploration forwards its current `frameTiles`",
          "consumer": "openMemorize \u2192 paint \u2192 composeSpellbook \u2192 drawOuterBorder"
        }
      ]
    },
    {
      "id": "town",
      "routes": [
        {
          "id": "standalone-town",
          "producer": "startTown defaults to CoK \u2192 CoK TILES_PATH \u2192 block-202 loadChrome",
          "consumer": "drawScreen \u2192 composeTownScreen \u2192 drawOuterBorder"
        }
      ]
    },
    {
      "id": "treasure",
      "routes": [
        {
          "id": "combat-treasure",
          "producer": "CoK combat loads `frameTileBytes` or its CoK tiles source, defaults to block 202 and extracts frame tiles",
          "consumer": "combat treasure branch \u2192 composeTreasure \u2192 drawOuterBorder",
          "condition": "The call omits a layout override; composeTreasure defaults to COK_FRAME_LAYOUT."
        }
      ]
    },
    {
      "id": "wilderness",
      "routes": [
        {
          "id": "standalone-wilderness",
          "producer": "startWilderness \u2192 CoK TILES_PATH \u2192 block-202 loadChrome",
          "consumer": "drawScreen \u2192 composeWildernessScreen \u2192 drawOuterBorder"
        }
      ]
    }
