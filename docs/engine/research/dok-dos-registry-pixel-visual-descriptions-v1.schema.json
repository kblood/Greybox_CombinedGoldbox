{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DoK DOS exact registry pixel review transfer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "inputSha256", "reviewScope", "candidateScope", "appearances"],
  "properties": {
    "schema": { "const": "dok-dos-registry-pixel-visual-descriptions-v1" },
    "inputSha256": {
      "type": "object",
      "minProperties": 12,
      "maxProperties": 12,
      "propertyNames": { "pattern": "^(cok|dok)-[a-z0-9-]+-v1\\.json$" },
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "reviewScope": { "type": "string", "minLength": 1 },
    "candidateScope": { "type": "string", "minLength": 1 },
    "appearances": {
      "type": "array", "minItems": 335, "maxItems": 335, "uniqueItems": true,
      "items": { "$ref": "#/$defs/appearance" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "pixelSha256", "visualDescription", "targets", "donorIds"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "pixelSha256": { "$ref": "#/$defs/sha256" },
        "visualDescription": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/target" }
        },
        "donorIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^cok/(amiga|dos-ega)/disk[1-3]/[a-z0-9]+\\.da[ax]/block/[0-9]+/(tile|frame)/[0-9]+$"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "archiveSha256", "sourceContentSha256"],
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^dok/dos-ega/dos-install/[a-z0-9]+\\.dax/block/[0-9]+/entry/[0-9]+/(tile|frame)/[0-9]+$"
        },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "sourceContentSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
