{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned DoK DOS graphics archive occurrences",
  "type": "object",
  "required": ["schema", "inventoryReference", "files"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "dok-graphics-source-roster-v1" },
    "inventoryReference": { "const": "docs/dos-inventory.md" },
    "files": {
      "type": "array", "minItems": 37, "maxItems": 37, "uniqueItems": true,
      "items": {
        "type": "object", "required": ["path", "sha256", "bytes", "tocBlockIds"], "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Z0-9]+\\.DAX$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 11 },
          "tocBlockIds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
        }
      }
    }
  }
}
